// PortTrack veritabani semasi
// Yerel gelistirmede SQLite kullanilir. Dagitimda provider "postgresql" yapilip
// Neon baglanti dizesi DATABASE_URL'e verilir; modeller ayni kalir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions            Transaction[]
  instruments             Instrument[]
  portfolioMonthSnapshots PortfolioMonthSnapshot[]
  notes                   Note[]
  analysisBriefings       AnalysisBriefing[]
  feedbacks               Feedback[]
}

/// Her alis/satis islemi (kendi para biriminde saklanir)
model Transaction {
  id        String   @id @default(cuid())
  userId    String   @default("default-user-id")
  date      DateTime
  assetType String // BIST | TEFAS | FOREIGN | FX | METAL | CRYPTO | BES
  symbol    String
  side      String // BUY | SELL
  unitPrice Float
  quantity  Float
  total     Float
  currency  String // TRY | USD | EUR ...
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([date])
  @@index([userId])
}

/// Sembol -> fiyat kaynagi haritasi
model Instrument {
  symbol      String
  userId      String   @default("default-user-id")
  assetType   String
  name        String?
  yahooSymbol String?
  currency    String   @default("TRY")
  priceSource String   @default("yahoo") // yahoo | tefas | manual
  manualPrice Float?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([symbol, userId])
  @@index([userId])
}

/// Gunluk kapanis fiyat onbellegi (gecmis grafikler icin)
/// close = TL cinsinden birim fiyat; native = kendi para birimindeki fiyat
model PriceSnapshot {
  id             String   @id @default(cuid())
  symbol         String
  date           DateTime
  close          Float
  native         Float?
  nativeCurrency String?
  currency       String
  source         String?
  investors      Int?

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

/// USDTRY vb. kur gecmisi
model FxRate {
  id   String   @id @default(cuid())
  date DateTime
  pair String // ornek: USDTRY
  rate Float

  @@unique([pair, date])
  @@index([pair])
  @@index([date])
}

/// Manuel ay sonu bakiyeleri (backlog.xlsx ve BES guncellemeleri)
model PortfolioMonthSnapshot {
  id         String   @id @default(cuid())
  userId     String   @default("default-user-id")
  month      DateTime // ayin 1'i (YYYY-MM-01)
  besTRY     Float    @default(0)
  bistTRY    Float    @default(0)
  tefasTRY   Float    @default(0)
  foreignTRY Float    @default(0)
  fxTRY      Float    @default(0)
  metalTRY   Float    @default(0)
  cryptoTRY  Float    @default(0)
  totalTRY   Float    @default(0)
  totalUSD   Float?
  usdTryRate Float?
  source     String   @default("backlog") // backlog | manual
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month])
  @@index([userId])
}

/// Günlük teknik analiz sonuçları (cron veya manuel tetik ile hesaplanır)
model TechnicalAnalysis {
  id          String   @id @default(cuid())
  symbol      String
  assetType   String
  date        DateTime @default(now())

  /// Ham göstergeler (JSON)
  indicators  Json

  /// Hesaplanmış skor (0-100)
  score       Int

  /// Üretilen yorum metni
  commentary  String

  /// Sinyal bayrakları (filtreleme için)
  trendSignal String   // STRONG_UP | UP | DOWN | STRONG_DOWN
  macdSignal  String   // POSITIVE | NEGATIVE | BUY_CROSS | SELL_CROSS
  rsiZone     String   // OVERSOLD | NEUTRAL | OVERBOUGHT

  /// Uyarılar (JSON dizi)
  alerts      Json     @default("[]")

  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}

/// AI analiz briefing (günlük, kullanıcı bazlı cache)
model AnalysisBriefing {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // günün 00:00'ı
  contextHash String
  payload     Json
  model       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Kullanıcı notları (Genel Bakış sayfasında gösterilir)
model Note {
  id        String   @id @default(cuid())
  userId    String   @default("default-user-id")
  content   String
  color     String   @default("default") // default | blue | green | amber | red | purple
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pinned])
  @@index([userId])
}

/// Sistem ve kullanıcı eylemleri audit log tablosu
model SystemLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // LOGIN | PRICE_REFRESH_MANUAL | CRON_PRICE_REFRESH | CRON_DAILY_DIGEST | TRANSACTION_ADD ...
  status    String   // SUCCESS | FAILED
  details   String?  // JSON veya detay açıklaması
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Kullanıcı Geri Bildirimleri & İstekleri (Öneri, Hata, Şikayet)
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  type      String   // SUGGESTION | BUG | COMPLAINT | OTHER
  subject   String?
  message   String
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}
